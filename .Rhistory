#| label: fig-penguin-mass
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
library(tidyverse)
#| label: fig-penguin-mass1
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
library(readxl)
library(tidyverse)
# the data shown below comes from the link https://github.com/ttimbers/canlang/raw/master/inst/extdata/victoria_lang.tsv named victoria. It is about the language used at specific situations and their frequency compared in a single table.
victoria <- read_delim("https://raw.githubusercontent.com/ttimbers/canlang/master/inst/extdata/victoria_lang.tsv", delim = "\t")
head(victoria, 20)
#| label: fig-penguin-mass2
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
modified <- victoria |> group_by(language) |> summarize('mean value langage users at home' = mean(most_at_home))
modified
#| label: fig-penguin-mass3
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
modified1 <- victoria |> group_by(language) |> summarize('mean value langage users at work' = mean(most_at_work))
modified1
#| label: fig-penguin-mass4
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
modified2 <- victoria |> group_by(language) |> summarize('mean value langage users at home' = mean(lang_known))
modified2
library(tidyverse)
victoria |>
slice_max(lang_known, n = 10) |>
pivot_longer(
cols = c(most_at_home, most_at_work, lang_known),
names_to = "usage_type",
values_to = "count"
) |>
ggplot(aes(x = language, y = count, fill = category)) +
geom_col(position = "dodge") +
theme_minimal() +
labs(
title = "Language usage in Victoria",
x = "Language",
y = "Number of people",
fill = "Usage type"
) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
