# the data shown below comes from the link https://github.com/ttimbers/canlang/raw/master/inst/extdata/victoria_lang.tsv named victoria. It is about the language used at specific situations and their frequency compared in a single table.
import pandas as pd
import numpy as np
url = "https://raw.githubusercontent.com/ttimbers/canlang/master/inst/extdata/victoria_lang.tsv"
df = pd.read_csv(url, sep = "\t")
df.head(10)
df.columns
#| label: fig-penguin-mass1
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
df.groupby(by = "language")["most_at_home"].agg('mean')
df
#| label: fig-penguin-mass2
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
df.groupby(by = "language")["most_at_work"].agg('mean')
df
#| label: fig-penguin-mass3
#| fig-cap: "Body mass of penguins by species."
#| warning: false
#| message: false
df.groupby(by = "language")["lang_known"].agg('mean')
df
import pandas as pd
import matplotlib.pyplot as plt
# 读取tsv数据
url = "https://raw.githubusercontent.com/timbers/conlang/main/inst/extdata/victoria_lang.tsv"
victoria = pd.read_csv(url, sep = "\t")
# slice_max：取 lang_known 最大前10行
top10 = victoria.nlargest(n = 10, columns = "lang_known").copy()
# pivot_longer 等价：pd.melt()
df_long = top10.melt(
id_vars = ["language"],
value_vars = ["most_at_home", "most_at_work", "lang_known"],
var_name = "usage_type",
value_name = "count"
)
# 绘制并列分组柱状图
plt.figure(figsize=(12, 7))
# seaborn 最简单做dodge（并列柱子）
import seaborn as sns
sns.barplot(
data = df_long,
x = "language",
y = "count",
hue = "usage_type",
dodge = True
)
plt.title("Language usage in Victoria")
plt.xlabel("Language")
plt.ylabel("Number of people")
plt.xticks(rotation = 45, ha = "right") # x轴标签旋转，和R一致
plt.tight_layout() # 防止文字被截断
plt.show()
